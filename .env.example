# BEAM platform environment variables.
# Copy to .env.local and fill in. Never commit real values.
# Full table per mode (sandbox, CI, Vercel preview, staging, production):
# docs/plan/04-build-session.md section 1.4.

# ---- Runtime mode -------------------------------------------------------
# One of local, preview, staging, production.
APP_ENV=local
# Absolute base URL for links in emails, webhooks and the fake pay page.
APP_URL=http://localhost:3000
# Playwright base URL (end-to-end runs use a production build on port 3100).
E2E_BASE_URL=http://localhost:3100

# ---- Database (Neon Postgres) -------------------------------------------
# During the build, DATABASE_URL points at the development database (beam_dev);
# production (neondb) is only used at go-live, by a human.
# Pooled connection string: used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.c-7.eu-central-1.aws.neon.tech/beam_dev?sslmode=require&channel_binding=require"
# Direct (unpooled) connection string: used for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-XXXX.c-7.eu-central-1.aws.neon.tech/beam_dev?sslmode=require&channel_binding=require"
# "pg" (Vercel, TCP 5432) or "neon-ws" (Neon WebSocket driver on port 443, for
# environments without TCP 5432 such as the cloud sandbox and CI).
# Tests always use in-memory PGlite via createTestDb() and ignore this setting.
DATABASE_DRIVER=pg

# ---- Sandbox proxy (cloud sandbox only) ----------------------------------
# Node's fetch and WebSocket go through the sandbox proxy.
NODE_USE_ENV_PROXY=
# Proxy CA bundle, for example /root/.ccr/ca-bundle.crt.
NODE_EXTRA_CA_CERTS=

# ---- Secrets generated per environment -----------------------------------
# openssl rand -base64 32
AUTH_SECRET=
# true outside Vercel (Auth.js v5).
AUTH_TRUST_HOST=true
# openssl rand -hex 32 (the tick route checks Authorization: Bearer <secret>).
CRON_SECRET=
# openssl rand -base64 32 (32 bytes, AES-256-GCM key for sensitive data; different per environment).
SENSITIVE_DATA_KEY_V1=
# openssl rand -hex 32 (commerce voucher codes).
VOUCHER_CODE_SECRET=
# openssl rand -hex 32 (automation webhook step signatures).
AUTOMATION_WEBHOOK_SECRET=

# ---- Fake-provider mode --------------------------------------------------
# "fake" selects every provider fake (local, CI, preview). Forbidden in production.
INTEGRATIONS=fake
# "1" forces only the payments fake. Forbidden in production.
PAYMENTS_FAKE=
# Every outgoing email goes to this address instead (sandbox, CI, preview, staging).
# Forbidden in production.
EMAIL_SINK=sink@beam.be
# In-process job tick under next dev/start (local only; refused elsewhere). Playwright sets 1000.
LOCAL_TICK_MS=5000

# ---- Demo data (never in production) -------------------------------------
# Password of the nine <role>@demo.beam.be staff accounts (24 characters).
DEMO_STAFF_PASSWORD=
# Base32 TOTP secret of the demo staff accounts (32 characters).
DEMO_TOTP_SECRET=

# ---- Payments (absent key = payments fake) --------------------------------
# staging test_..., production live_...
MOLLIE_API_KEY=
MOLLIE_WEBHOOK_SECRET=
# Stub adapters: refuse selection without these.
STRIPE_API_KEY=
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=

# ---- Invoicing (Billit; absent key = Billit fake) -------------------------
BILLIT_API_KEY=
# Sandbox https://api.sandbox.billit.be, live https://api.billit.be
BILLIT_BASE_URL=
BILLIT_PARTY_ID=

# ---- Email (Resend; absent key = Resend fake) -----------------------------
RESEND_API_KEY=
# Svix whsec_... value of the Resend webhook.
RESEND_WEBHOOK_SECRET=

# ---- AI (Anthropic; absent key = scripted fake) ---------------------------
ANTHROPIC_API_KEY=

# ---- Alerts and monitoring -------------------------------------------------
SLACK_WEBHOOK_URL=
# Absent DSN disables the Sentry SDK.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
# Absent heartbeat URL skips the ping; absent token uses the SLA fake.
BETTERSTACK_HEARTBEAT_URL=
BETTERSTACK_API_TOKEN=
BETTERSTACK_MONITOR_ID=

# ---- Google (YouTube Live and Meet, Release 2) ----------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ---- Ads and Meta inbox (Release 3) ---------------------------------------
META_ADS_TOKEN=
GOOGLE_ADS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# ---- Backups (after go-live, GitHub Actions only) -------------------------
BACKUP_AGE_PUBLIC_KEY=
