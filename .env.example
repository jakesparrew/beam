# Copy to .env.local and fill in. Never commit real values.
# Pooled connection string: used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct (unpooled) connection string: used for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-XXXX.c-7.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# "pg" (default; Vercel with Fluid compute) or "neon-http" (environments without TCP port 5432, e.g. the cloud sandbox or CI).
DATABASE_DRIVER="pg"
