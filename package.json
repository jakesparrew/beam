{
  "name": "beam-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @beam/db generate",
    "db:migrate": "pnpm --filter @beam/db migrate",
    "db:check": "pnpm --filter @beam/db check",
    "test": "turbo run test",
    "db:check-migrations": "pnpm --filter @beam/db check-migrations"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~5.9.3"
  }
}
