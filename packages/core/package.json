{
  "name": "@beam/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./i18n": "./src/i18n/index.ts",
    "./i18n/messages/*": "./src/i18n/messages/*",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@date-fns/tz": "catalog:",
    "date-fns": "catalog:",
    "intl-messageformat": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@beam/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
