{
  "name": "@beam/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts",
    "./seed": "./src/seed/run.ts",
    "./testing/*": "./src/testing/*.ts",
    "./seed/*": "./src/seed/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "generate": "pnpm -w gen:indexes && drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts",
    "check": "tsx scripts/check.ts",
    "check-migrations": "tsx scripts/check-migrations.ts",
    "views": "tsx scripts/views-sql.ts",
    "append-only": "tsx scripts/append-only-sql.ts",
    "docs-schema": "tsx scripts/docs-schema.ts",
    "test:migrations": "vitest run test/test-db.test.ts"
  },
  "dependencies": {
    "@beam/core": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@neondatabase/serverless": "catalog:",
    "@vercel/functions": "catalog:",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@beam/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
