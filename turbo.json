{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "loose",
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "DATABASE_DRIVER",
    "NODE_ENV",
    "APP_ENV",
    "INTEGRATIONS",
    "PAYMENTS_FAKE",
    "EMAIL_SINK"
  ],
  "tasks": {
    "//#gen:indexes": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "//#gen:indexes"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "//#gen:indexes"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^typecheck", "//#gen:indexes"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["//#gen:indexes"],
      "cache": false,
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["//#gen:indexes"],
      "cache": false,
      "persistent": true
    }
  }
}
